---
import { ShieldCheck, ArrowUp } from 'lucide-astro';
---

<footer class="footer-section">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo-wrap">
          <img src="/images/chebg.png" alt="Chebg Logo" class="footer-logo" />
        </div>
        <div class="footer-brand-text">
          <span class="footer-title font-display">CHEBG</span>
          <span class="footer-desc">Colección de Juegos Favoritos de Chebg</span>
        </div>
      </div>

      <div class="cloudflare-badge glass-card">
        <ShieldCheck size={20} class="cf-icon" />
        <div class="cf-text">
          <span class="cf-title">Cloudflare & Vercel Ready</span>
          <span class="cf-status">Optimizado & Ultra Rápido</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copyright">© 2026 CHEBG. Todos los derechos reservados.</span>
      <a href="#" class="back-top-link">
        <span>Volver Arriba</span>
        <ArrowUp size={14} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    padding: 4rem 0 2.5rem 0;
    border-top: 1px solid var(--border-color);
    margin-top: 5rem;
    background: rgba(7, 8, 11, 0.6);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
    padding: 2px;
    background: var(--gradient-vice);
  }

  .footer-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    background: #000;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    font-size: 1.4rem;
    font-weight: 800;
  }

  .footer-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cloudflare-badge {
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cf-icon {
    color: var(--accent-cyan);
  }

  .cf-text {
    display: flex;
    flex-direction: column;
  }

  .cf-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .cf-status {
    font-size: 0.72rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .back-top-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-top-link:hover {
    color: var(--accent-pink);
  }
</style>
